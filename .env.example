# Copy to .env for local development. Never commit the real .env file.

# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:replace_me

# Telegram numeric user id for the bot admin
ADMIN_USER_ID=123456789

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Bot username without @ (used by the Mini App to open/share the bot)
BOT_USERNAME=your_bot

# Local HTTP port. Render injects PORT automatically.
PORT=8080

# Security/runtime
APP_ENV=production
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
WEB_THREADS=4

# Development-only auth shortcut. Keep false in every deployed environment.
ALLOW_DEBUG_AUTH=false
# When APP_ENV=development and ALLOW_DEBUG_AUTH=true, send X-Debug-User-Id header.
