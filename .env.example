# Copy to .env for local development. Never commit the real .env file.

# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:replace_me

# Telegram numeric user id for the bot admin
ADMIN_USER_ID=123456789

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Bot username without @ (used by the Mini App and durable PvP share links)
BOT_USERNAME=your_bot

# Local HTTP port. Render injects PORT automatically.
PORT=8080

# Telegram transport. Local development defaults to polling. Render production
# sets this to webhook in render.yaml so inbound Telegram traffic can wake a
# sleeping Free web service without any self-ping keepalive workaround.
TELEGRAM_TRANSPORT=polling
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=1
# Optional outside Render webhook deployments:
# TELEGRAM_WEBHOOK_BASE_URL=https://example.com
# Optional stable secret; if omitted, one is derived from BOT_TOKEN:
# TELEGRAM_WEBHOOK_SECRET=replace_with_16_to_256_safe_characters

# Security/runtime
APP_ENV=production
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
WEB_THREADS=4
# Server envelope must fit Telegram Update JSON. Mini App quiz requests retain
# their own smaller per-request cap.
MAX_REQUEST_BODY_BYTES=1048576
MINIAPP_MAX_REQUEST_BODY_BYTES=65536
MAX_REQUEST_HEADER_BYTES=65536

# Development-only auth shortcut. Keep false in every deployed environment.
ALLOW_DEBUG_AUTH=false
# When APP_ENV=development and ALLOW_DEBUG_AUTH=true, send X-Debug-User-Id header.
